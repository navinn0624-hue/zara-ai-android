<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOverlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp">

    <!-- Glowing Bottom Sheet Floating Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#E610121D"
        app:cardCornerRadius="24dp"
        app:strokeColor="#406366F1"
        app:strokeWidth="1.5dp"
        app:cardElevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

            <!-- Top Row: Title & Close -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvZaraBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ ZARA ASSISTANT"
                    android:textColor="@color/indigo_500"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_centerVertical="true" />

                <ImageView
                    android:id="@+id/btnCloseOverlay"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:tint="@color/zinc_400" />
            </RelativeLayout>

            <!-- Animated Glowing Orb -->
            <FrameLayout
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginVertical="12dp">

                <View
                    android:id="@+id/viewGlowRing"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/siri_glow_orb" />
            </FrameLayout>

            <!-- Spoken Text Display -->
            <TextView
                android:id="@+id/tvLiveSpeech"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Listening... 'Zara insta po' / 'WhatsApp-la Suresh-ku hi nu sollu'"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textAlignment="center"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <!-- Response Status Text -->
            <TextView
                android:id="@+id/tvAssistantStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speak now in Tamil or English..."
                android:textColor="@color/zinc_400"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
