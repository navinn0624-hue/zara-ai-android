<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOverlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal|bottom"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!-- Frosted Glass Siri Assistant Card -->
    <LinearLayout
        android:id="@+id/cardAssistantContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/siri_glass_card"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="18dp"
        android:elevation="12dp">

        <!-- Top Header: Badge & Close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvZaraBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ ZARA INTELLIGENCE"
                android:textColor="#FF818CF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_centerVertical="true" />

            <ImageView
                android:id="@+id/btnCloseOverlay"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/zinc_400" />
        </RelativeLayout>

        <!-- Live Spoken Text from User -->
        <TextView
            android:id="@+id/tvLiveSpeech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Listening... 'Zara whatsapp la hi sollu' / 'Set timer for 5 mins'"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <!-- Assistant AI Reply / Action Status -->
        <TextView
            android:id="@+id/tvAssistantStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ask any question or give any phone command ✨"
            android:textColor="#FF00F2FE"
            android:textSize="13sp"
            android:textAlignment="center"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- iPhone Bottom Center Siri Glowing Orb Structure -->
    <FrameLayout
        android:id="@+id/frameSiriOrb"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Layer 1: Ambient Outer Glow Halo -->
        <View
            android:id="@+id/viewGlowOuter"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:background="@drawable/siri_glow_outer" />

        <!-- Layer 2: Radiant Vibrant Pulse Ring -->
        <View
            android:id="@+id/viewGlowMiddle"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_gravity="center"
            android:background="@drawable/siri_glow_middle" />

        <!-- Layer 3: Dynamic Siri Core Orb -->
        <View
            android:id="@+id/viewGlowCore"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_gravity="center"
            android:background="@drawable/siri_glow_core" />

    </FrameLayout>

</LinearLayout>
