<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Luxury Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Z A R A"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.25" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal Voice OS Assistant"
                    android:textColor="#FF818CF8"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Status Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/siri_glass_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/viewLiveDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/circle_green" />

                <TextView
                    android:id="@+id/tvHeaderLiveStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="ONLINE"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Centerpiece: Holographic Apple Siri Glowing Orb -->
        <FrameLayout
            android:id="@+id/heroSiriOrbContainer"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="32dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Ambient Halo Layer -->
            <View
                android:id="@+id/heroGlowOuter"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/siri_glow_outer" />

            <!-- Radiant Mid Ring -->
            <View
                android:id="@+id/heroGlowMiddle"
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:layout_gravity="center"
                android:background="@drawable/siri_glow_middle" />

            <!-- Dynamic Core Orb -->
            <View
                android:id="@+id/heroGlowCore"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/siri_glow_core" />
        </FrameLayout>

        <!-- Touch Orb Label -->
        <TextView
            android:id="@+id/tvHeroHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap Orb or Say 'Zara' Anytime"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Works with screen ON, OFF, or inside any app"
            android:textColor="@color/zinc_400"
            android:textSize="12sp"
            android:layout_marginTop="3dp" />

        <!-- Quick Capabilities Carousel / Showcase -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CAPABILITIES"
            android:textColor="#FF818CF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <!-- Showcase Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Card 1: WhatsApp -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/siri_glass_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 WhatsApp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&quot;Suresh-ku hi anupu&quot;"
                    android:textColor="@color/zinc_400"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Card 2: Device -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/siri_glass_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔦 Device"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&quot;Torch on / Volume kootu&quot;"
                    android:textColor="@color/zinc_400"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="8dp">

            <!-- Card 3: Timer & Alarms -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/siri_glass_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱️ Alarms"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&quot;5 mins timer vai&quot;"
                    android:textColor="@color/zinc_400"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Card 4: Gemini AI Brain -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/siri_glass_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧠 Gemini AI"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&quot;Ask any question&quot;"
                    android:textColor="@color/zinc_400"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- System Permissions Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SYSTEM CONTROLS"
            android:textColor="#FF818CF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp" />

        <!-- Control 1: Floating Overlay -->
        <LinearLayout
            android:id="@+id/rowOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/siri_glass_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Siri Floating Display"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shows glowing orb at bottom center over any app"
                    android:textColor="@color/zinc_400"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrantOverlay"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Enable"
                android:textSize="11sp"
                app:backgroundTint="@color/indigo_500" />
        </LinearLayout>

        <!-- Control 2: Accessibility Automation -->
        <LinearLayout
            android:id="@+id/rowAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/siri_glass_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone Automation Engine"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto-types WhatsApp messages &amp; opens apps"
                    android:textColor="@color/zinc_400"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrantAccessibility"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Enable"
                android:textSize="11sp"
                app:backgroundTint="@color/pink_500" />
        </LinearLayout>

        <!-- Control 3: Microphone & 24/7 Voice Wake -->
        <LinearLayout
            android:id="@+id/rowMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/siri_glass_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24/7 Voice Wake (Microphone)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allows 'Zara' wake word even when screen is locked"
                    android:textColor="@color/zinc_400"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrantMic"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Enable"
                android:textSize="11sp"
                app:backgroundTint="#FF10B981" />
        </LinearLayout>

        <!-- Control 4: Floating Siri Edge Bubble Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/siri_glass_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assistive Siri Edge Bubble"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Floating touch shortcut at screen edge"
                    android:textColor="@color/zinc_400"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchFloatingBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- Gemini Key Setup (Optional) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/siri_glass_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google Gemini Key (Optional)"
                android:textColor="#FF818CF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zara works with built-in AI. Adding your free key gives ultra-fast 200ms responses."
                android:textColor="@color/zinc_400"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etGeminiKey"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="#20FFFFFF"
                    android:hint="Paste Gemini API Key"
                    android:textColorHint="@color/zinc_400"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:paddingHorizontal="10dp"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/btnSaveGeminiKey"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Save"
                    android:textSize="11sp"
                    android:layout_marginStart="8dp"
                    app:backgroundTint="#FF6366F1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGetGeminiKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👉 Tap here to get Free Key from aistudio.google.com"
                android:textColor="#FF34D399"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Big Launch Siri Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLaunchSiri"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✨ ACTIVATE SIRI OVERLAY"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/indigo_500"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
