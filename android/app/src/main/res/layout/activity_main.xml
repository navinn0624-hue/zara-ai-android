<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zara AI Assistant"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHeaderSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hands-free Phone Controller (Tamil &amp; English)"
        android:textColor="@color/zinc_400"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle" />

    <!-- Status Indicator Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/card_dark"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/zinc_700"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/circle_green" />

                <TextView
                    android:id="@+id/tvServiceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Status: Ready to Listen"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Say 'Hey Zara' from any screen or app to activate!"
                android:textColor="@color/zinc_400"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Permission 1: Overlay -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOverlayPerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/card_dark"
        app:cardCornerRadius="14dp"
        app:strokeColor="@color/zinc_700"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardStatus">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Display Over Other Apps"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shows floating Siri overlay over any app"
                    android:textColor="@color/zinc_400"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrantOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable"
                android:textSize="12sp"
                app:backgroundTint="@color/indigo_500" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Permission 2: Accessibility Service -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAccessibilityPerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/card_dark"
        app:cardCornerRadius="14dp"
        app:strokeColor="@color/zinc_700"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardOverlayPerm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Accessibility Automation"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto-types messages inside WhatsApp and clicks buttons"
                    android:textColor="@color/zinc_400"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrantAccessibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable"
                android:textSize="12sp"
                app:backgroundTint="@color/pink_500" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Test Assistant Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTestZara"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🚀 Test Floating Zara Now"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/indigo_500"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/cardAccessibilityPerm" />

</androidx.constraintlayout.widget.ConstraintLayout>
